-- Tải thư viện Rayfield (Link Sirius ổn định)
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Cặc",
   LoadingTitle = "Đang vào hỏi hỏi cc...",
   ConfigurationSaving = { Enabled = false }
})

local Tab = Window:CreateTab("Triệu Hồi Lính", nil)

-- 1. Chức năng triệu hồi Archer
Tab:CreateButton({
   Name = "Triệu hồi Persian Archer (180 Xu)",
   Callback = function()
       local args = {
           [1] = "Persian Archer",
           [2] = 0
       }
       game:GetService("ReplicatedStorage"):WaitForChild("ShopRemotes"):WaitForChild("BuySoldier"):FireServer(unpack(args))
       
       Rayfield:Notify({Title = "Hệ thống", Content = "Đã gửi lệnh triệu hồi Xạ thủ!", Duration = 2})
   end,
})

